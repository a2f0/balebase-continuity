{
  "name": "@a2f0/balebase-continuity",
  "version": "0.1.1",
  "description": "Canonical fictional people, equipment, and records rendered into the genesis data that seeds Balebase",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a2f0/balebase-continuity.git"
  },
  "exports": {
    "./genesis/*": "./genesis/*",
    "./package.json": "./package.json"
  },
  "files": [
    "genesis"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "agent-tool": "agent-tool",
    "agent:logs": "agent-tool logs",
    "agent:run": "agent-tool run",
    "agents:check": "bun run agent-tool skills check && bun run agent-tool permissions check",
    "agents:sync": "bun run agent-tool skills install --apply && bun run agent-tool permissions install --apply",
    "canon:check": "bun src/cli.ts validate",
    "check": "agent-tool run-group scripts/testing/check.json",
    "check:fast": "agent-tool run-group scripts/testing/check-fast.json",
    "genesis": "bun src/cli.ts generate",
    "genesis:check": "bun src/cli.ts check",
    "hooks:check": "agent-tool hooks check",
    "hooks:install": "agent-tool hooks install --apply",
    "images": "bun src/images/cli.ts",
    "lint:biome": "biome check --error-on-warnings",
    "lint:binary-files": "agent-tool checks binaries",
    "lint:branch-name": "agent-tool branch check",
    "lint:commit-message": "agent-tool commits check --message-file",
    "lint:commit-trust": "agent-tool commits check",
    "lint:files": "ls-lint",
    "lint:knip": "knip",
    "lint:markdown": "git ls-files -z -- '*.md' | xargs -0 bun --bun x markdownlint-cli2",
    "lint:markdown:fix": "git ls-files -z -- '*.md' | xargs -0 bun --bun x markdownlint-cli2 --fix",
    "lint:scripts": "git ls-files -z -- '*.sh' 'scripts/git/hooks/*' | xargs -0 shellcheck",
    "lint:skills": "bun scripts/checks/checkProjectSkills.ts",
    "site:build": "bun src/site/build.ts",
    "site:deploy": "bun run check && wrangler deploy",
    "site:dev": "bun src/site/build.ts && wrangler dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{css,html,js,json,jsonc,jsx,mjs,cjs,ts,tsx}": "biome check --fix --error-on-warnings",
    "*.md": "bun --bun x markdownlint-cli2 --fix"
  },
  "devDependencies": {
    "@a2f0/agent-tool": "0.1.46",
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@ls-lint/ls-lint": "2.3.2",
    "@resvg/resvg-js": "2.6.2",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.4",
    "jpeg-js": "0.4.4",
    "knip": "6.44.1",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.24.0",
    "typescript": "7.0.2",
    "wrangler": "4.151.3"
  }
}
