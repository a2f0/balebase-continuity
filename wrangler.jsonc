{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "balebase-continuity",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "preview_urls": false,
  // balebase's Terraform (terraform/stacks/prod) owns continuity.balebase.com.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
